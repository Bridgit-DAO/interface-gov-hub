FLASK_ENV=development
FLASK_PORT=5000
# Set locally; never commit real secrets.
SECRET_KEY=replace-with-a-local-random-secret
REFERRAL_TOKEN_SECRET=replace-with-a-different-local-random-secret
# Internal Layer.id values. Empty disables the feature for all layers.
GOVHUB_COMMUNITY_INTELLIGENCE_LAYERS=
# Optional: preserve legacy development upload location if applicable.
# GOVHUB_UPLOAD_ROOT=/home/ubuntu/data-tracker/uploads
# Use only for isolated tests. Normal app migrations stay explicit.
GOVHUB_SKIP_SHARED_DB_MIGRATIONS=1
